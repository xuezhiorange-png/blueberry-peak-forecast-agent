# TEMPLATE ONLY. Never source into a real deployment or use literal placeholders.
# All listeners MUST bind 127.0.0.1; TLS termination must disable untrusted proxy
# headers. backend.tests.safe_pilot.run creates private random PG credentials.
APP_ENV=test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=<DEDICATED_NON_DEFAULT_TEST_PORT>
POSTGRES_USER=<SYNTHETIC_TASK_OWNED_ROLE>
POSTGRES_PASSWORD=<RANDOM_PRIVATE_TEST_ONLY_SECRET>
POSTGRES_DB=<TASK_GENERATED_UUID_DATABASE>
LOCAL_AUTH_ORIGIN=https://127.0.0.1:<OWNED_TLS_PORT>
LOCAL_AUTH_LOGIN_BUCKET_SECRET=<RANDOM_PRIVATE_TEST_ONLY_SECRET>
LOCAL_AUTH_ORGANIZATION_IDS_JSON=["SYNTHETIC_ORG"]
# Use the ACTUAL validated SimpleAdminCatalog schema and exact canonical bindings.
# No wildcard, future-run enrolment or client-provided catalog expansion.
LOCAL_AUTH_SIMPLE_ADMIN_CATALOG_JSON=<VALIDATED_SYNTHETIC_EXACT_RESOURCE_CATALOG_JSON>
# Simple-admin mode needs no legacy per-user publisher approvals; do not configure
# a second contradictory management authority. Missing/invalid catalog denies admin.
LOCAL_AUTH_PUBLISHER_BOUNDARIES_JSON=
BUSINESS_ACCESS_SIGNING_KEY=<AT_LEAST_32_CHAR_RANDOM_PRIVATE_TEST_ONLY_KEY>
FORECAST_INTELLIGENCE_MCP_POLICY_FILE=<ABSOLUTE_PRIVATE_0700_DIRECTORY>/policy.json
# FilePolicy publisher creates mode-0600 policy + stable lock, monotonic revision,
# expiry, exact trusted host/origin and independent quality grants. POSIX local FS.
# HTTP: backend.app.main:app; MCP: create_service_account_app (never static config).
# Execution scripts bind ONLY loopback, use TLS and --no-proxy-headers.
# Do not expose development Compose ports/passwords, legacy apps or dev Vite.
