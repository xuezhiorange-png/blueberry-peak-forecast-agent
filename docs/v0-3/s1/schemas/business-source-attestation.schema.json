{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V0.3-S1 Business Source Attestation",
  "description": "Source authority identity and physical/Q2C attestation shape. It contains no personal identity fields and does not itself authorize data access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_version",
    "source_system",
    "source_dataset",
    "source_version",
    "schema_version",
    "schema_hash",
    "source_snapshot_reference",
    "source_owner_role",
    "attestation_effective_at",
    "effective_time",
    "attestation_status",
    "attestation_hash",
    "coverage_scope",
    "revision_policy",
    "withdrawal_and_void_policy",
    "known_exclusions",
    "physical_event",
    "weighing_point_and_relation_to_pick",
    "quantity_basis",
    "quantity_unit",
    "all_picked_or_marketable",
    "field_sorting_rule",
    "packhouse_sorting_rule",
    "rejected_fruit_rule",
    "transport_before_weighing",
    "storage_before_weighing",
    "postharvest_loss_rule",
    "tare_policy",
    "measurement_method",
    "scale_precision",
    "scale_calibration_authority",
    "farm_timezone",
    "local_day_boundary",
    "late_entry_rule",
    "missing_day_rule",
    "correction_rule",
    "void_rule",
    "final_confirmation_rule",
    "visibility_boundary",
    "grain",
    "plot_supported",
    "coverage_summary"
  ],
  "properties": {
    "attestation_version": { "type": "string", "minLength": 1 },
    "source_system": { "type": "string", "minLength": 1 },
    "source_dataset": { "type": "string", "minLength": 1 },
    "source_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "schema_hash": { "$ref": "#/$defs/sha256" },
    "source_snapshot_reference": { "$ref": "#/$defs/opaqueReference" },
    "source_owner_role": { "type": "string", "minLength": 1 },
    "attestation_effective_at": { "type": "string", "format": "date-time" },
    "effective_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_from",
        "effective_to_or_open_ended",
        "authority_timezone"
      ],
      "properties": {
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to_or_open_ended": { "type": "string", "minLength": 1 },
        "authority_timezone": { "type": "string", "minLength": 1 }
      }
    },
    "attestation_status": {
      "type": "string",
      "enum": ["ATTESTED", "DRAFT", "SUPERSEDED", "REVOKED", "UNSIGNED", "INFERRED"]
    },
    "attestation_hash": { "$ref": "#/$defs/sha256" },
    "coverage_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seasons",
        "farms",
        "subfarms",
        "varieties",
        "business_date_start",
        "business_date_end",
        "known_scope_boundaries"
      ],
      "properties": {
        "seasons": { "$ref": "#/$defs/stringArray" },
        "farms": { "$ref": "#/$defs/stringArray" },
        "subfarms": { "$ref": "#/$defs/stringArray" },
        "varieties": { "$ref": "#/$defs/stringArray" },
        "business_date_start": { "type": "string", "format": "date" },
        "business_date_end": { "type": "string", "format": "date" },
        "known_scope_boundaries": { "$ref": "#/$defs/stringArray" }
      }
    },
    "revision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_policy_version",
        "revision_policy_identity",
        "winner_and_lineage_rule"
      ],
      "properties": {
        "revision_policy_version": { "type": "string", "minLength": 1 },
        "revision_policy_identity": { "$ref": "#/$defs/opaqueReference" },
        "winner_and_lineage_rule": { "type": "string", "minLength": 1 }
      }
    },
    "withdrawal_and_void_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withdrawal_policy_version",
        "void_propagation_policy_version",
        "withdrawal_status_rule",
        "void_status_rule"
      ],
      "properties": {
        "withdrawal_policy_version": { "type": "string", "minLength": 1 },
        "void_propagation_policy_version": { "type": "string", "minLength": 1 },
        "withdrawal_status_rule": { "type": "string", "minLength": 1 },
        "void_status_rule": { "type": "string", "minLength": 1 }
      }
    },
    "known_exclusions": { "$ref": "#/$defs/stringArray" },
    "physical_event": { "const": "FARM_PICK" },
    "weighing_point_and_relation_to_pick": { "type": "string", "minLength": 1 },
    "quantity_basis": { "const": "OBSERVED_WEIGHT" },
    "quantity_unit": { "const": "KG" },
    "all_picked_or_marketable": { "type": "string", "minLength": 1 },
    "field_sorting_rule": { "type": "string", "minLength": 1 },
    "packhouse_sorting_rule": { "type": "string", "minLength": 1 },
    "rejected_fruit_rule": { "type": "string", "minLength": 1 },
    "transport_before_weighing": { "type": "string", "minLength": 1 },
    "storage_before_weighing": { "type": "string", "minLength": 1 },
    "postharvest_loss_rule": { "type": "string", "minLength": 1 },
    "tare_policy": { "type": "string", "minLength": 1 },
    "measurement_method": { "type": "string", "minLength": 1 },
    "scale_precision": { "type": "string", "minLength": 1 },
    "scale_calibration_authority": { "type": "string", "minLength": 1 },
    "farm_timezone": { "type": "string", "minLength": 1 },
    "local_day_boundary": { "type": "string", "minLength": 1 },
    "late_entry_rule": { "type": "string", "minLength": 1 },
    "missing_day_rule": { "const": "UNKNOWN_NOT_ZERO" },
    "correction_rule": { "type": "string", "minLength": 1 },
    "void_rule": { "type": "string", "minLength": 1 },
    "final_confirmation_rule": { "type": "string", "minLength": 1 },
    "visibility_boundary": { "type": "string", "minLength": 1 },
    "grain": { "const": "SEASON × FARM × SUBFARM × VARIETY × HARVEST_BUSINESS_DATE" },
    "plot_supported": { "const": false },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season_count",
        "farm_count",
        "subfarm_count",
        "variety_count",
        "first_harvest_business_date",
        "last_harvest_business_date",
        "source_row_count",
        "missing_day_count",
        "missing_data_proportion"
      ],
      "properties": {
        "season_count": { "type": "integer", "minimum": 0 },
        "farm_count": { "type": "integer", "minimum": 0 },
        "subfarm_count": { "type": "integer", "minimum": 0 },
        "variety_count": { "type": "integer", "minimum": 0 },
        "first_harvest_business_date": { "type": "string", "format": "date" },
        "last_harvest_business_date": { "type": "string", "format": "date" },
        "source_row_count": { "type": "integer", "minimum": 0 },
        "missing_day_count": { "type": "integer", "minimum": 0 },
        "missing_data_proportion": {
          "type": "string",
          "pattern": "^(0|1|0\\.[0-9]+|1\\.0+)$"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "opaqueReference": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
