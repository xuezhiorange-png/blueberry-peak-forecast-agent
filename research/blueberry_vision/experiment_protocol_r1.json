        "test_prediction_seal_hash",
        "reference_hash",
        "evaluator_hash",
        "test_access_exposure_log",
        "per_record_error_report"
      ],
      "step": "E7_ONE_SHOT_INDEPENDENT_TEST"
    },
    {
      "action": "REPORT_OVERALL_STRATA_COVERAGE_UNDEFINED_FAILURES_RESOURCES_AND_PRE_REGISTERED_GATE_DECISION",
      "failure": "ENGINEERING_PREPARATION_ONLY_OR_RESEARCH_GATE_FAIL",
      "outputs": [
        "metric_report",
        "resource_report",
        "negative_results",
        "reproducibility_manifest",
        "gate_decision"
      ],
      "step": "E8_REPORT_AND_STOP"
    }
  ]
}
